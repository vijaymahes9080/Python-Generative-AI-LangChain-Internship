# Environment Variables Example for AI Innovation Studio
# Copy this file to .env and insert your API keys as needed.

# ==============================================================================
# Provider API Keys (Optional - Applications will fall back to Deterministic Mode)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# Model Configurations
# ==============================================================================
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
DEFAULT_OPENAI_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-004

# ==============================================================================
# Task-Specific Configurations
# ==============================================================================
# Task 2: Vector DB Persistence Path
CHROMA_PERSIST_DIR=./chroma_db_store

# Task 3: Agent Sandbox Path
AGENT_SANDBOX_DIR=./sandbox_data
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_SECONDS=30
